<ContentDialog
    x:Class="WindowsIconsAdmin_App.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Configuración"
    PrimaryButtonText="Aceptar"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MinWidth="480" HorizontalAlignment="Stretch" Spacing="20" Padding="0,0,8,0">

            <!-- Sección: Almacenamiento de Iconos -->
            <StackPanel Spacing="12">
                <TextBlock Text="Almacenamiento de Iconos" FontWeight="SemiBold" Style="{StaticResource SubtitleTextBlockStyle}" />

                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <ToggleSwitch x:Name="EnablePortableModeToggle"
                                      Header="Habilitar Modo Portable (avanzado)"
                                      OffContent="Desactivado (Solo Caché Central)"
                                      OnContent="Activado (Permite guardar en carpetas)"
                                      Toggled="OnPortableModeToggled" />

                        <TextBlock Text="Por defecto, WindowsIconsAdmin almacena los iconos de manera centralizada en AppData. Esto mantiene todas tus carpetas 100% limpias sin añadir archivos de icono (.ico) adicionales en ellas."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <InfoBar x:Name="PortableWarningInfoBar"
                                 Severity="Warning"
                                 IsOpen="False"
                                 IsClosable="False"
                                 Title="Advertencia de Modo Portable"
                                 Message="El modo portable crea un archivo oculto (.folder_icon.ico) en cada carpeta. Esto puede interferir con repositorios de Git o herramientas de sincronización si no se ignoran." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Sección: Caché Central -->
            <StackPanel Spacing="12">
                <TextBlock Text="Caché Central" FontWeight="SemiBold" Style="{StaticResource SubtitleTextBlockStyle}" />

                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Ubicación de almacenamiento central:" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="CachePathTextBlock" Text="%LOCALAPPDATA%\WindowsIconsAdmin\Icons" FontWeight="Medium" Style="{StaticResource BodyTextBlockStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <Button Content="Abrir carpeta de caché en el Explorador" Click="OnOpenCacheFolderClick" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Sección: Compatibilidad con Git -->
            <StackPanel Spacing="12">
                <TextBlock Text="Compatibilidad con Repositorios Git" FontWeight="SemiBold" Style="{StaticResource SubtitleTextBlockStyle}" />

                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Windows Explorer requiere el archivo desktop.ini en cada carpeta para asignarle un icono personalizado. Para evitar que Git lo detecte como cambio no guardado en tus repositorios, puedes agregarlo a tu .gitignore global."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <Button x:Name="ConfigureGitIgnoreButton" Content="Configurar desktop.ini en .gitignore global" Click="OnConfigureGitIgnoreClick" />
                        <TextBlock x:Name="GitIgnoreStatusTextBlock" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
