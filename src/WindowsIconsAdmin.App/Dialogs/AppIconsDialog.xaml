<ContentDialog
    x:Class="WindowsIconsAdmin_App.Dialogs.AppIconsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WindowsIconsAdmin_App.ViewModels"
    Title="Personalizar Iconos de Aplicaciones"
    CloseButtonText="Cerrar"
    DefaultButton="None"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
    </ContentDialog.Resources>

    <Grid Width="880" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Explicación superior -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Padding="12,8">
            <TextBlock Text="Personaliza los accesos directos de tus aplicaciones instaladas con un estilo visual coherente y suave. Los cambios no modifican los archivos ejecutables y son 100% reversibles."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Barra de selección de estilo y escaneo -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="StyleComboBox" Grid.Column="0" Header="Estilo visual a aplicar" HorizontalAlignment="Stretch" SelectionChanged="OnStyleSelectionChanged" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Editar estilos..." Click="OnOpenStyleEditorClick" ToolTipService.ToolTip="Personalizar forma, color y parámetros de tratamiento" />
            <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Escanear aplicaciones" Style="{StaticResource AccentButtonStyle}" Click="OnScanAppsClick" ToolTipService.ToolTip="Volver a buscar accesos directos instalados en el sistema">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <!-- Lista de aplicaciones -->
        <Border Grid.Row="2"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Padding="12"
                MinHeight="360"
                MaxHeight="440">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barra de selección rápida -->
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="AppCountLabel" Text="0 aplicaciones detectadas" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Content="Marcar soportadas" Click="OnSelectSupportedClick" />
                        <Button Content="Desmarcar todas" Click="OnDeselectAllClick" />
                    </StackPanel>
                </Grid>

                <!-- Lista de apps -->
                <ListView x:Name="AppsListView" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppItemViewModel">
                            <Grid ColumnSpacing="12" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox de inclusión -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          IsEnabled="{x:Bind IsSupported}"
                                          VerticalAlignment="Center"
                                          ToolTipService.ToolTip="Incluir en el lote de personalización" />

                                <!-- Preview del icono estilizado -->
                                <Image Grid.Column="1"
                                       Source="{x:Bind StyledPreview, Mode=OneWay}"
                                       Width="36"
                                       Height="36"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center" />

                                <!-- Información de la app -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind PrimaryTargetPath}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Badge de compatibilidad -->
                                <Border Grid.Column="3"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        CornerRadius="4"
                                        Background="{ThemeResource LayerFillColorAltBrush}">
                                    <TextBlock Text="{x:Bind SupportBadgeText}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Medium" />
                                </Border>

                                <!-- Estado de operación -->
                                <TextBlock Grid.Column="4"
                                           Text="{x:Bind Status, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Barra de progreso -->
        <Grid Grid.Row="3" x:Name="ProgressArea" Visibility="Collapsed" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="BatchProgressBar" Grid.Row="0" IsIndeterminate="False" />
            <TextBlock x:Name="ProgressStatusText" Grid.Row="1" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Barra de acciones inferiores y Feedback -->
        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <InfoBar x:Name="MainInfoBar" Grid.Column="0" IsOpen="False" />

            <Button x:Name="UndoButton" Grid.Column="1" Content="Deshacer lote anterior" Click="OnUndoLastBatchClick" ToolTipService.ToolTip="Revertir el último lote de iconos de aplicaciones modificados" />
            <Button x:Name="ApplyButton" Grid.Column="2" Content="Aplicar estilo a seleccionadas" Style="{StaticResource AccentButtonStyle}" Click="OnApplySelectedClick" />
        </Grid>
    </Grid>
</ContentDialog>
