<ContentDialog
    x:Class="WindowsIconsAdmin_App.Dialogs.StyleEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WindowsIconsAdmin_App.ViewModels"
    Title="Editor de Estilos de Aplicaciones"
    PrimaryButtonText="Guardar estilo"
    SecondaryButtonText="Restablecer"
    CloseButtonText="Cerrar"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSaveStyleClick"
    SecondaryButtonClick="OnResetStyleClick"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
    </ContentDialog.Resources>

    <Grid Width="880" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Descripción superior -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Padding="12,8">
            <TextBlock Text="Personaliza el contenedor y el tratamiento visual suave para las aplicaciones de Windows. La previsualización se calcula en memoria en tiempo real sin modificar accesos directos ni el sistema."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Cuerpo de 2 columnas: Controles a la izquierda, Previews a la derecha -->
        <Grid Grid.Row="1" ColumnSpacing="16" MinHeight="440">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <!-- Columna Izquierda: Parámetros del Estilo -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <!-- Nombre del estilo -->
                        <TextBox x:Name="StyleNameBox" Header="Nombre del estilo" Text="Soft Lavender" TextChanged="OnParameterChanged" />

                        <!-- Forma del contenedor -->
                        <TextBlock Text="Forma del contenedor" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ComboBox x:Name="ShapeCombo" HorizontalAlignment="Stretch" SelectionChanged="OnParameterChanged">
                            <ComboBoxItem Content="Squircle (Superelipse)" Tag="Squircle" IsSelected="True" />
                            <ComboBoxItem Content="Cuadrado redondeado" Tag="RoundedSquare" />
                            <ComboBoxItem Content="Círculo" Tag="Circle" />
                        </ComboBox>

                        <!-- Color de fondo -->
                        <TextBlock Text="Color de fondo (Hex)" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBox x:Name="BgColorBox" Text="#E6DBFA" TextChanged="OnParameterChanged" />
                        <!-- Paleta de colores rápidos -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Padding="0" Width="28" Height="28" Background="#E6DBFA" ToolTipService.ToolTip="Lavanda Suave" Click="OnPaletteColorClick" Tag="#E6DBFA" />
                            <Button Padding="0" Width="28" Height="28" Background="#D1F2D9" ToolTipService.ToolTip="Menta Suave" Click="OnPaletteColorClick" Tag="#D1F2D9" />
                            <Button Padding="0" Width="28" Height="28" Background="#FCD5CE" ToolTipService.ToolTip="Rosa Pastel" Click="OnPaletteColorClick" Tag="#FCD5CE" />
                            <Button Padding="0" Width="28" Height="28" Background="#D0E8FF" ToolTipService.ToolTip="Azul Cielo" Click="OnPaletteColorClick" Tag="#D0E8FF" />
                            <Button Padding="0" Width="28" Height="28" Background="#2D3142" ToolTipService.ToolTip="Grafito Oscuro" Click="OnPaletteColorClick" Tag="#2D3142" />
                            <Button Padding="0" Width="28" Height="28" Background="#1E1E2E" ToolTipService.ToolTip="Pizarra Nocturna" Click="OnPaletteColorClick" Tag="#1E1E2E" />
                        </StackPanel>

                        <!-- Padding Slider -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Margen interior (Padding)" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="PaddingValueLabel" Grid.Column="1" Text="16%" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Slider x:Name="PaddingSlider" Minimum="0" Maximum="40" Value="16" StepFrequency="1" ValueChanged="OnParameterChanged" />

                        <!-- Saturación Slider -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Saturación" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="SaturationValueLabel" Grid.Column="1" Text="-15%" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" Value="-15" StepFrequency="5" ValueChanged="OnParameterChanged" />

                        <!-- Brillo Slider -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Brillo" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="BrightnessValueLabel" Grid.Column="1" Text="+5%" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" Value="5" StepFrequency="5" ValueChanged="OnParameterChanged" />

                        <!-- Contraste Slider -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Contraste" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="ContrastValueLabel" Grid.Column="1" Text="0%" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0" StepFrequency="5" ValueChanged="OnParameterChanged" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Columna Derecha: Vista previa en vivo -->
            <Border Grid.Column="1"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="14">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Previsualización en tiempo real" FontWeight="SemiBold" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Comparativa original vs. estilizado para varias aplicaciones:" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ListView x:Name="PreviewListView" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppPreviewItemViewModel">
                                <Grid ColumnSpacing="16" Padding="10,8" Margin="0,2" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icono Original -->
                                    <Image Grid.Column="0" Source="{x:Bind OriginalImageSource}" Width="40" Height="40" Stretch="Uniform" />

                                    <!-- Flecha de transición -->
                                    <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                    <!-- Icono Estilizado -->
                                    <Image Grid.Column="2" Source="{x:Bind StyledImageSource, Mode=OneWay}" Width="48" Height="48" Stretch="Uniform" />

                                    <!-- Nombre de la aplicación -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="Vista previa generada" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra de estado / Feedback -->
        <InfoBar x:Name="StatusInfoBar" Grid.Row="2" IsOpen="False" />
    </Grid>
</ContentDialog>
