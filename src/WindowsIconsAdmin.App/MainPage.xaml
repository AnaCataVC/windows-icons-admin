<Page
    x:Class="WindowsIconsAdmin_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowsIconsAdmin_App"
    xmlns:vm="using:WindowsIconsAdmin_App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="12" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de herramientas superior -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent" BorderThickness="0">
            <AppBarButton Icon="Folder" Label="Agregar carpetas" Click="OnAddFoldersClick" />
            <AppBarButton Icon="Pictures" Label="Seleccionar icono" Click="OnSelectIconClick" />
            <AppBarSeparator />
            <AppBarButton Icon="Accept" Label="Aplicar icono" Click="OnApplyIconClick" />
            <AppBarButton Icon="Refresh" Label="Restaurar predeterminado" Click="OnRestoreDefaultClick" />
            <AppBarButton Icon="Undo" Label="Revertir último cambio" Click="OnUndoLastBatchClick" />
            <AppBarSeparator />
            <AppBarButton Icon="Setting" Label="Reglas" Click="OnRulesClick" />
            <AppBarButton Icon="Admin" Label="Iconos del sistema" Click="OnSystemIconsClick" />
            <AppBarButton Icon="Delete" Label="Limpiar lista" Click="OnClearListClick" />
        </CommandBar>

        <!-- Contenido principal: Lista a la izquierda, Panel de control a la derecha -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" MaxWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Zona de lista y Drag & Drop -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="12"
                    AllowDrop="True"
                    DragOver="OnListDragOver"
                    Drop="OnListDrop">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Carpetas seleccionadas" FontWeight="SemiBold" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Seleccionar todas" Click="OnSelectAllClick" />
                            <Button Content="Deseleccionar todas" Click="OnDeselectAllClick" />
                        </StackPanel>
                    </Grid>

                    <!-- Mensaje si lista vacía -->
                    <StackPanel x:Name="EmptyListPlaceholder" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xED25;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Arrastra carpetas aquí desde el Explorador" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="o presiona 'Agregar carpetas' en la barra superior." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Lista de carpetas -->
                    <ListView x:Name="FoldersListView" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderItemViewModel">
                                <Grid ColumnSpacing="12" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="1" Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FolderName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind FullPath}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind WarningText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#D97706" Visibility="{x:Bind WarningVisibility, Mode=OneWay}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" FontWeight="Medium" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Panel lateral derecho: Previsualización y Configuración -->
            <StackPanel Grid.Column="1" Spacing="16">
                <!-- Tarjeta: Icono Seleccionado -->
                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Vista previa del icono" FontWeight="SemiBold" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        
                        <Border Width="96" Height="96" HorizontalAlignment="Center" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Image x:Name="IconPreviewImage" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" />
                        </Border>

                        <TextBlock x:Name="IconInfoLabel" Text="Ningún icono seleccionado" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button Content="Seleccionar archivo (.ico / .png)" HorizontalAlignment="Stretch" Click="OnSelectIconClick" />
                    </StackPanel>
                </Border>

                <!-- Tarjeta: Modo de Almacenamiento -->
                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Ubicación del icono" FontWeight="SemiBold" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <RadioButtons x:Name="StorageModeRadioButtons" SelectedIndex="0">
                            <RadioButton Content="Modo Portable" Tag="Portable">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="Copia .folder_icon.ico oculto dentro de cada carpeta con ruta relativa. El icono sobrevive al mover o copiar a pendrives." />
                                </ToolTipService.ToolTip>
                            </RadioButton>
                            <RadioButton Content="Caché Central en AppData" Tag="Central">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="Guarda los iconos en %LOCALAPPDATA% con ruta absoluta. No añade archivos a las carpetas." />
                                </ToolTipService.ToolTip>
                            </RadioButton>
                        </RadioButtons>
                        <TextBlock Text="Portable es ideal para pendrives y carpetas compartidas." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Botón principal de aplicación -->
                <Button Content="Aplicar icono a seleccionadas" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="40" Click="OnApplyIconClick" />
            </StackPanel>
        </Grid>

        <!-- Barra de progreso para lotes -->
        <Grid Grid.Row="2" x:Name="ProgressArea" Visibility="Collapsed" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProgressStatusText" Text="Procesando lote..." Style="{StaticResource CaptionTextBlockStyle}" />
            <Button Grid.Column="1" Content="Cancelar" Click="OnCancelBatchClick" />
            <ProgressBar x:Name="BatchProgressBar" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" />
        </Grid>

        <!-- Mensajes y avisos -->
        <InfoBar x:Name="MainInfoBar" Grid.Row="3" IsOpen="False" />
    </Grid>
</Page>
