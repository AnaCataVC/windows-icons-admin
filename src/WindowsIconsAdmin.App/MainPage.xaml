<Page
    x:Class="WindowsIconsAdmin_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowsIconsAdmin_App"
    xmlns:vm="using:WindowsIconsAdmin_App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="12" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de acciones frecuentes; las herramientas secundarias viven en un solo menú. -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent" BorderThickness="0">
            <AppBarButton Icon="Folder" Label="Agregar carpetas" Click="OnAddFoldersClick" ToolTipService.ToolTip="Selecciona una o varias carpetas a la vez (Ctrl o Shift + clic)" />
            <AppBarSeparator />
            <AppBarButton Icon="Refresh" Label="Restaurar" Click="OnRestoreDefaultClick" ToolTipService.ToolTip="Restaurar el icono predeterminado de las carpetas marcadas" />
            <AppBarButton Icon="Undo" Label="Deshacer" Click="OnUndoLastBatchClick" ToolTipService.ToolTip="Revertir el último cambio" />

            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Agregar subcarpetas de..." Click="OnAddSubfoldersClick" ToolTipService.ToolTip="Elige una carpeta raíz y agrega sus subcarpetas directas" />
                <AppBarButton Label="Reglas" Click="OnRulesClick" />
                <AppBarButton Label="Iconos del sistema" Click="OnSystemIconsClick" />
                <AppBarButton Label="Configuración" Click="OnSettingsClick" />
                <AppBarButton Label="Limpiar lista" Click="OnClearListClick" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- Contenido principal: Lista a la izquierda, Panel de control a la derecha -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" MaxWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Zona de lista y Drag & Drop -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="12"
                    AllowDrop="True"
                    DragOver="OnListDragOver"
                    Drop="OnListDrop">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="FoldersHeaderTitle"
                                       Text="Carpetas seleccionadas"
                                       FontWeight="SemiBold"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="FoldersSelectionSubtitle"
                                       Text="Puedes elegir varias carpetas con Ctrl/Shift o arrastrarlas desde el Explorador"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Marcar todas" Click="OnSelectAllClick" />
                            <Button Content="Desmarcar todas" Click="OnDeselectAllClick" />
                            <Button Content="Solo resaltadas" Click="OnCheckHighlightedOnlyClick" ToolTipService.ToolTip="Marca únicamente las filas seleccionadas con Ctrl o Shift en la lista" />
                        </StackPanel>
                    </Grid>

                    <!-- Mensaje si lista vacía -->
                    <StackPanel x:Name="EmptyListPlaceholder" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xED25;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Agrega las carpetas que quieres personalizar" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Arrástralas desde el Explorador o usa Agregar carpetas en la barra superior." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>

                    <!-- Lista de carpetas -->
                    <ListView x:Name="FoldersListView" Grid.Row="1" SelectionMode="Extended">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderItemViewModel">
                                <Grid ColumnSpacing="12" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="1" Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FolderName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind FullPath}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind WarningText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#D97706" Visibility="{x:Bind WarningVisibility, Mode=OneWay}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" FontWeight="Medium" />

                                    <Button Grid.Column="4"
                                            Content="✕"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            Click="OnRemoveSingleFolderClick"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Quitar esta carpeta de la lista" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Panel lateral derecho: Previsualización y Configuración -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" Padding="0,0,4,0">
                <!-- Tarjeta: Icono Seleccionado -->
                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Vista previa del icono" FontWeight="SemiBold" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        
                        <Border Width="96" Height="96" HorizontalAlignment="Center" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Image x:Name="IconPreviewImage" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" />
                        </Border>

                        <TextBlock x:Name="IconInfoLabel" Text="Ningún icono seleccionado" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button Content="Seleccionar archivo (.ico / .png)" HorizontalAlignment="Stretch" Click="OnSelectIconClick" />
                    </StackPanel>
                </Border>

                <!-- Tarjeta: Modo de Almacenamiento -->
                <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Ubicación del icono" FontWeight="SemiBold" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <!-- Modo Central Predeterminado (cuando PortableMode no está activado en Configuración) -->
                        <StackPanel x:Name="CentralOnlyStoragePanel" Spacing="6" Visibility="Visible">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE753;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Caché Central en AppData" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Los iconos se guardan de forma centralizada en tu AppData. Las carpetas permanecen 100% limpias sin archivos adicionales."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Selector avanzado de modo (solo visible si EnablePortableMode está activado en Configuración) -->
                        <StackPanel x:Name="AdvancedStorageSelectionPanel" Spacing="8" Visibility="Collapsed">
                            <RadioButtons x:Name="StorageModeRadioButtons" SelectedIndex="0">
                                <RadioButton Content="Caché Central en AppData (Recomendado)" Tag="Central">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="Guarda los iconos en %LOCALAPPDATA% con ruta absoluta. No añade archivos a las carpetas." />
                                    </ToolTipService.ToolTip>
                                </RadioButton>
                                <RadioButton Content="Modo Portable (.folder_icon.ico)" Tag="Portable">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="Copia .folder_icon.ico oculto dentro de cada carpeta con ruta relativa. Ideal para pendrives USB." />
                                    </ToolTipService.ToolTip>
                                </RadioButton>
                            </RadioButtons>
                            <TextBlock Text="Caché Central mantiene tus carpetas y repositorios limpios." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Botón principal de aplicación (siempre visible) -->
                <Button x:Name="ApplyIconPrimaryButton" Grid.Row="1" Content="Aplicar icono a seleccionadas" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="40" Click="OnApplyIconClick" />
            </Grid>
        </Grid>

        <!-- Barra de progreso para lotes -->
        <Grid Grid.Row="2" x:Name="ProgressArea" Visibility="Collapsed" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProgressStatusText" Text="Procesando lote..." Style="{StaticResource CaptionTextBlockStyle}" />
            <Button Grid.Column="1" Content="Cancelar" Click="OnCancelBatchClick" />
            <ProgressBar x:Name="BatchProgressBar" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" />
        </Grid>

        <!-- Mensajes y avisos -->
        <InfoBar x:Name="MainInfoBar" Grid.Row="3" IsOpen="False" />
    </Grid>
</Page>
